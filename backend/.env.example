# picks the config class: development | testing | production
ATLAS_ENV=development

# shared secret for the X-Atlas-Key header. Empty = nobody can publish.
# generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ATLAS_WRITE_KEY=

# anonymous writes allowed per sliding window
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW=3600

# defaults to backend/instance/atlas.db and backend/uploads if left unset
# DATABASE_URL=sqlite:///instance/atlas.db
# UPLOAD_DIR=./uploads

# exact origins, comma-separated, never *
CORS_ORIGINS=http://localhost:5173
